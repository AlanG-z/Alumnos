<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.2" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd">
  <persistence-unit name="AlumnosEJB_PU" transaction-type="JTA">
    <jta-data-source>jdbc/bdalumnos</jta-data-source>
    <class>com.mycompany.alumnos.Alumno</class>
    <class>com.mycompany.alumnos.Carrera</class>
    <class>com.mycompany.alumnos.Docente</class>
    <class>com.mycompany.alumnos.Examen</class>
    <class>com.mycompany.alumnos.ExamenPK</class>
    <class>com.mycompany.alumnos.Facultad</class>
    <class>com.mycompany.alumnos.Materia</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
  </persistence-unit>
</persistence>
